RewriteEngine On

# 1. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 2. Block Direct Access to Sensitive Files and Directories
<FilesMatch "^\.(env|git|htaccess|gitignore)|(\.(sql|log|md|json|lock))$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block Direct Access to Core Internal Directories
RewriteRule ^(app|config|database|storage|views)/ - [F,L,NC]

# 4. Route Everything Through public/ Folder
RewriteCond %{REQUEST_URI} !^/finance-portal/public/
RewriteRule ^(.*)$ /finance-portal/public/$1 [L,QSA]

